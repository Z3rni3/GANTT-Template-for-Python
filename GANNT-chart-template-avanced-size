def _new_row(kind, id_, name, **fields):
    """Internal: creates the dictionary that describes one row."""
    row = dict(kind=kind, id=None if id_ is None else str(id_), name=name, ext=False,
               start=None, end=None, duration=None, progress=None, dep=None, buffer=0,
               baseline=None, owner=None, status=None, priority=None, note=None, color=None)
    row.update(fields)
    return row


def G(name, ext=False, *, start=None, end=None, progress=None, owner=None, status=None,
      priority=None, note=None, color=None):
    """Phase / group header. Bar = from the first task start to the last task end."""
    return _new_row("group", None, name, ext=ext, start=start, end=end, progress=progress,
                    owner=owner, status=status, priority=priority, note=note, color=color)


def T(id_, name, start=None, end=None, *, duration=None, progress=None, dep=None, ext=False,
      buffer=0, baseline=None, owner=None, status=None, priority=None, note=None, color=None):
    """Task. Give two of start / end / duration (or `dep` plus a duration)."""
    return _new_row("task", id_, name, start=start, end=end, duration=duration,
                    progress=progress, dep=dep, ext=ext, buffer=buffer, baseline=baseline,
                    owner=owner, status=status, priority=priority, note=note, color=color)


def M(id_, name, date=None, *, dep=None, owner=None, status=None, priority=None, note=None,
      color=None):
    """Milestone. Without a date it is placed at the end of its predecessor."""
    return _new_row("milestone", id_, name, start=date, dep=dep, owner=owner, status=status,
                    priority=priority, note=note, color=color)


def D(id_, name, date, *, owner=None, status=None, priority=None, note=None, color=None):
    """Deadline set by someone else. date = "YYYY-MM-DD" or "YYYY-MM-DD HH:MM"."""
    return _new_row("deadline", id_, name, start=date, owner=owner, status=status,
                    priority=priority, note=note, color=color)


def E(id_, name, start, end=None, *, owner=None, status=None, priority=None, note=None,
      color=None):
    """Fixed date or event. One day (only start) or a period (start and end)."""
    return _new_row("event", id_, name, start=start, end=end, owner=owner, status=status,
                    priority=priority, note=note, color=color)


