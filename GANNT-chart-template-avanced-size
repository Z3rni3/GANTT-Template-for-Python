# 2) Validate the plan and calculate all dates
# ------------------------------------------------------------
_DEP_RE = re.compile(r"^(\w+)(?::(FS|SS|FF))?([+-]\d+)?$", re.IGNORECASE)


def _fail(row, message):
    raise PlanError(f"{row['kind'].capitalize()} '{row['name']}': {message}")


def _ts(row, field, value):
    """Reads a date; returns a Timestamp or None."""
    if value is None:
        return None
    try:
        ts = pd.Timestamp(value)
    except Exception:
        ts = pd.NaT
    if pd.isna(ts):
        _fail(row, f"cannot read {field} {value!r}. Please write dates as 'YYYY-MM-DD'.")
    return ts


def _day(row, field, value):
    ts = _ts(row, field, value)
    return None if ts is None else ts.normalize()


def _parse_deps(row):
    raw = row["dep"]
    if raw is None:
        return []
    items = [raw] if isinstance(raw, str) else list(raw)
    deps = []
    for item in items:
        m = _DEP_RE.match(str(item).replace(" ", ""))
        if not m:
            _fail(row, f"cannot read dependency {item!r}. Examples: 't1', 't1:SS', 't1:FS+2'.")
        deps.append((m.group(1), (m.group(2) or "FS").upper(), int(m.group(3) or 0)))
    return deps


# --- non-working periods and working-day arithmetic ---
NW_RANGES = []
for _item in NON_WORKING:
    _s, _e, *_rest = _item
    _s, _e = pd.Timestamp(_s).normalize(), pd.Timestamp(_e).normalize()
    if _e < _s:
        raise PlanError(f"NON_WORKING: period {_item!r} ends before it starts.")
    NW_RANGES.append((_s, _e, _rest[0] if _rest else ""))
NW_DAYS = set()
for _s, _e, _ in NW_RANGES:
    NW_DAYS.update(pd.date_range(_s, _e))


def is_workday(d):
    return d.weekday() < 5 and d.normalize() not in NW_DAYS


def next_workday(d):
    while not is_workday(d):
        d += DAY
    return d


def add_duration(start, dur):
    """Last day of a task that starts on `start` and lasts `dur` days."""
    if not DURATION_IN_WORKDAYS:
        return start + (dur - 1) * DAY
    d, left = start, dur
    while True:
        if is_workday(d):
            left -= 1
            if left == 0:
                return d
        d += DAY


def sub_duration(end, dur):
    """First day of a task that ends on `end` and lasts `dur` days."""
    if not DURATION_IN_WORKDAYS:
        return end - (dur - 1) * DAY
    d, left = end, dur
    while True:
        if is_workday(d):
            left -= 1
            if left == 0:
                return d
        d -= DAY


def count_days(start, end):
    if not DURATION_IN_WORKDAYS:
        return (end - start).days + 1
    return sum(is_workday(d) for d in pd.date_range(start, end))


# --- 2a) check every row ---
byid = {}
for r in rows:
    k = r["kind"]
    if k != "group":
        if r["id"] is None:
            r["id"] = f"_auto{len(byid) + 1}"
        if not re.fullmatch(r"\w+", r["id"]):
            _fail(r, f"id {r['id']!r} may only contain letters, digits and underscore.")
        if r["id"] in byid:
            _fail(r, f"the id '{r['id']}' is used twice. Every id must be unique.")
        byid[r["id"]] = r

    if r["status"] is not None:
        key = str(r["status"]).strip().lower()
        if key not in STATUS_STYLES:
            _fail(r, f"unknown status {r['status']!r}. Allowed: {', '.join(STATUS_STYLES)}.")
        r["status"] = key
    if r["priority"] is not None:
        r["priority"] = str(r["priority"]).strip().lower()
    if r["progress"] is not None and not 0 <= r["progress"] <= 1:
        _fail(r, "progress must be between 0.0 and 1.0.")
    if r["color"] is not None and not mcolors.is_color_like(r["color"]):
        _fail(r, f"color {r['color']!r} is not a valid color (use e.g. '#2169D8').")

    if k in ("group", "task", "event"):
        r["start"] = _day(r, "start", r["start"])
        r["end"] = _day(r, "end", r["end"])
    elif k == "milestone":
        r["start"] = _day(r, "date", r["start"])
    elif k == "deadline":
        raw = r["start"]
        r["dt"] = _ts(r, "date", raw)
        if r["dt"] is None:
            _fail(r, "a deadline needs a date.")
        r["has_time"] = bool(r["dt"] != r["dt"].normalize() or (isinstance(raw, str) and ":" in raw))
        r["start"] = r["end"] = r["dt"].normalize()
    if k == "event":
        if r["start"] is None:
            _fail(r, "an event needs a start date.")
        if r["end"] is None:
            r["end"] = r["start"]
        if r["end"] < r["start"]:
            _fail(r, "the end date is before the start date.")
    if k == "task":
        if r["duration"] is not None and (not isinstance(r["duration"], int) or r["duration"] < 1):
            _fail(r, "duration must be a whole number of days, at least 1.")
        if not isinstance(r["buffer"], int) or r["buffer"] < 0:
            _fail(r, "buffer must be a whole number of days, 0 or more.")
        if r["baseline"] is not None:
            try:
                b0, b1 = r["baseline"]
            except (TypeError, ValueError):
                _fail(r, "baseline must be a pair of dates: ('2026-11-01', '2026-11-10').")
            r["baseline"] = (_day(r, "baseline start", b0), _day(r, "baseline end", b1))
            if r["baseline"][1] < r["baseline"][0]:
                _fail(r, "the baseline ends before it starts.")
    else:
        r["buffer"] = 0
    r["deps"] = _parse_deps(r) if k in ("task", "milestone") else []

for r in rows:
    for pid, _, _ in r["deps"]:
        if pid not in byid:
            _fail(r, f"depends on '{pid}', but there is no row with this id. "
                     f"Known ids: {', '.join(byid)}.")
        if pid == r["id"]:
            _fail(r, "cannot depend on itself.")


# --- 2b) calculate dates, predecessors first ---
def end_eff(p):
    """End of a row including its buffer."""
    return p["end"] + p["buffer"] * DAY


def resolve_task(r):
    s, e, du = r["start"], r["end"], r["duration"]
    start_c, end_c = [], []
    for pid, typ, lag in r["deps"]:
        p = byid[pid]
        if typ == "FS":
            c = end_eff(p) + (1 + lag) * DAY
            start_c.append(next_workday(c) if DURATION_IN_WORKDAYS else c)
        elif typ == "SS":
            start_c.append(p["start"] + lag * DAY)
        else:
            end_c.append(p["end"] + lag * DAY)

    if s is None and start_c and not (e is not None and du is not None):
        s = max(start_c)
    if s is None and e is None and end_c and du is not None:
        e = max(end_c)

    if s is not None and e is not None:
        if e < s:
            _fail(r, "the end date is before the start date.")
        if du is not None and du != count_days(s, e):
            _fail(r, f"start ({s:%Y-%m-%d}), end ({e:%Y-%m-%d}) and duration ({du}) do not "
                     f"match. Give only two of them.")
        du = count_days(s, e)
    elif s is not None and du is not None:
        e = add_duration(s, du)
    elif e is not None and du is not None:
        s = sub_duration(e, du)
    else:
        _fail(r, "not enough information. Give two of start / end / duration, or a "
                 "dependency (dep=...) together with a duration.")
    r["start"], r["end"], r["duration"] = s, e, du


def resolve_milestone(r):
    d = r["start"]
    if d is None:
        cands = []
        for pid, typ, lag in r["deps"]:
            p = byid[pid]
            base = {"FS": end_eff(p), "SS": p["start"], "FF": p["end"]}[typ]
            cands.append(base + lag * DAY)
        if not cands:
            _fail(r, "needs a date, or a dependency (dep=...) to take the date from.")
        d = max(cands)
    r["start"] = r["end"] = d.normalize()


