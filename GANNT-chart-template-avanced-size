            need, actual = end_eff(p) + (lag + (0 if point else 1)) * DAY, r["start"]
        elif typ == "SS":
            need, actual = p["start"] + lag * DAY, r["start"]
        else:
            need, actual = p["end"] + lag * DAY, r["end"]
