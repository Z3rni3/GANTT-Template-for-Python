while pending:
    ready = [r for r in pending if all(pid in resolved for pid, _, _ in r["deps"])]
    if not ready:
        names = ", ".join(f"'{r['id']}'" for r in pending)
        raise PlanError(f"Circular dependency between: {names}. Check the 'dep' arguments.")
    for r in ready:
        (resolve_task if r["kind"] == "task" else resolve_milestone)(r)
        resolved.add(r["id"])
        pending.remove(r)

