def extent(artist, ax):
    """Horizontal extent of a text, in data coordinates of `ax`."""
    bb = artist.get_window_extent(renderer)
    inv = ax.transData.inverted()
    return inv.transform((bb.x0, bb.y0))[0], inv.transform((bb.x1, bb.y1))[0]


def fit_text(t, ax, max_right, min_size=7.0):
    """Shrinks (then shortens) a text so it does not run into the next column."""
    while extent(t, ax)[1] > max_right and t.get_fontsize() > min_size:
        t.set_fontsize(t.get_fontsize() - 0.5)
    core = t.get_text()
    while extent(t, ax)[1] > max_right and len(core) > 3:
        core = core[:-1]
        t.set_text(core.rstrip() + "…")


def place_text(xl, xr, y, s, prefer="left", gap_in=0.2, **style):
    """Puts a label left of `xl` or right of `xr`; switches side if it would leave the chart."""
    t = ax_g.text(0, y, s, va="center", zorder=3, **style)
    gap = px(gap_in)

    def put(side):
        if side == "right":
            t.set_x(xr + gap); t.set_ha("left")
        else:
            t.set_x(xl - gap); t.set_ha("right")
        x0, x1 = extent(t, ax_g)
        return x0, x1, (x0 >= x_left + px(0.04) and x1 <= x_right - px(0.04))

    order = [prefer, "left" if prefer == "right" else "right"]
    for side in order:
        x0, x1, ok = put(side)
        if ok:
            return t, side, x0, x1
    x0, x1, _ = put(order[0])
    return t, order[0], x0, x1


def label_and_note(xm, y, label, note, gap_in, **label_style):
    """Label next to a marker plus an optional note; the note never lands on top of the label."""
    t, side, x0, x1 = place_text(xm, xm, y, label, prefer="left", gap_in=gap_in, **label_style)
    if not note:
        return
    if side == "left":      # label on the left: note right of the marker, else left of the label
        place_text(x0, xm, y, note, prefer="right", gap_in=gap_in, **NOTE_STYLE)
    else:                   # label on the right: note behind the label, else left of the marker
        place_text(xm, x1, y, note, prefer="right", gap_in=0.12, **NOTE_STYLE)


