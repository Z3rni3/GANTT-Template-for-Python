# ------------------------------------------------------------
def arrow(p_from, p_to):
    ax_g.annotate("", xy=p_to, xytext=p_from, zorder=4,
                  arrowprops=dict(arrowstyle="-|>", color=DEP_LINE, lw=1.1,
                                  shrinkA=0, shrinkB=0, mutation_scale=9))


def polyline(pts):
    ax_g.plot([p[0] for p in pts], [p[1] for p in pts], color=DEP_LINE, lw=1.1,
              zorder=3, solid_joinstyle="miter", clip_on=False)   # not clipped at the chart edge


Dx = px(0.085)                                   # length of the short stubs next to the bars
for r in rows:
    for pid, typ, lag in r["deps"]:
        a = byid[pid]
        ya, yb = a["y"], r["y"]
        down = yb >= ya
        edge = ya + 0.5 if down else ya - 0.5    # border of the predecessor's row
        point = r["kind"] in POINT_KINDS
        tip = px(0.10) if point else 0           # stop in front of a diamond / flag

        if typ == "FS":
            xf, xt = a["xe_eff"], r["xs"]
            if point and abs(xf - xt) < px(0.06):          # straight line into a milestone
                arrow((xf, ya + (a["h"] if down else -a["h"])),
                      (xt, yb - (r["h"] if down else -r["h"])))
                continue
            pts = [(xf, ya), (xf + Dx, ya), (xf + Dx, edge), (xt - Dx, edge), (xt - Dx, yb)]
            polyline(pts)
            arrow(pts[-1], (xt - tip, yb))
        elif typ == "SS":
            xf, xt = a["xs"], r["xs"]
            xv = min(xf, xt) - Dx
            polyline([(xf, ya), (xv, ya), (xv, yb)])
            arrow((xv, yb), (xt - tip, yb))
        else:  # FF
            xf, xt = a["xe_eff"], r["xe"]
            xv = max(xf, xt) + Dx
            polyline([(xf, ya), (xv, ya), (xv, yb)])
            arrow((xv, yb), (xt + tip, yb))

